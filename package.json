{
  "name": "buen-fin-app",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/heic-convert": "^2.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "3.4.2",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "typescript7": "npm:typescript@^7.0.2"
  },
  "scripts": {
    "test": "vitest",
    "dev:back": "tsx --env-file .env --watch src/services/backend/app.ts",
    "dev:up": "docker compose --env-file .env up -d",
    "dev:down": "docker compose down",
    "dev:stop": "docker compose stop",
    "db:up": "docker compose --project-directory . -f src/services/db/image.docker-compose.yaml --env-file .env up -d",
    "db:down": "docker compose -f src/services/db/image.docker-compose.yaml down",
    "db:stop": "docker compose -f src/services/db/image.docker-compose.yaml stop",
    "db:restart": "docker compose -f src/services/db/image.docker-compose.yaml restart",
    "db:migration": "drizzle-kit push",
    "db:console": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc-alias",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "image:process-image": "bash bin/queue-image",
    "process-image:start": "bash bin/queue-start",
    "process-image:stop": "docker stop buen-fin-app-image-service && docker rmi buen-fin-app-image-service",
    "process-image:rebuild": "docker rmi buen-fin-app-image-service"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@nodecfdi/credentials": "github:nasa14119/nodecfdi-credentials#main",
    "@nodecfdi/rfc": "github:nasa14119/nodecfdi-rfc#main",
    "argon2": "^0.45.1",
    "blurhash": "^2.0.5",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "fast-blurhash": "^1.2.0",
    "heic-convert": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "tsc-alias": "^1.9.5",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  }
}
