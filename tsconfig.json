{
  "$schema": "https://www.schemastore.org/tsconfig",
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2024",
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./dist",
    // Environment setup & latest features
    "paths": {
      "@images/types": ["./src/services/image-service/types.js"],
      "@images/*": ["./src/services/image-service/src/images/*"],
      "@bucket/*": ["./src/services/image-service/src/bucket/*"],
      "@images-service": ["./src/services/image-service/index.ts"],
      "@images-service/*": ["./src/services/image-service/*"],
      "@db/*": ["./src/services/db/*"],
      "@auth/*": ["./src/services/backend/auth/*"],
      "@app/types": ["./src/lib/types/types.js"],
      "@app/utils": ["./src/lib/utils.js"],
      "@env": ["./src/config/index.js"],
      "@config/*": ["./src/config/*"],
      "@backend/*": ["./src/services/backend/*"],
      "@sat/*": ["./src/services/sat/*"],
      "@lib/*": ["./src/lib/*"],
    },
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/frontend/**"],
}
