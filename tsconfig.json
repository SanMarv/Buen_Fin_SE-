{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["node"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": "./src",
    "paths": {
      "@images/types": ["services/image-service/types.ts"],
      "@images/*": ["services/image-service/src/images/*"],
      "@bucket/*": ["services/image-service/src/bucket/*"],
      "@images-service/*": ["services/image-service/*"],
      "@images-service": ["services/image-service/index.ts"],
      "@db/*": ["services/db/*"],
      "@types": ["types/types.ts"],
    },
  },
}
